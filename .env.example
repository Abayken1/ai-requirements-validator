# Скопируйте этот файл в .env и вставьте свой ключ:  cp .env.example .env
# Файл .env в репозиторий не попадает (он в .gitignore).

# Модель сданного отчёта: NVIDIA API (бесплатный ключ без карты: https://build.nvidia.com → Get API Key)
# Раскомментируй 4 строки ниже и вставь ключ nvapi-...
# LLM_API_KEY=nvapi-your_key_here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_STREAM=1

# Google Gemini — бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Список моделей, доступных по ключу: python validate.py --list-models
GEMINI_MODEL=gemini-3.1-flash-lite

# Либо другой провайдер (используется первый найденный ключ):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Любой другой OpenAI-совместимый API (OpenRouter, Groq и т.п.) — те же LLM_API_KEY / LLM_BASE_URL / LLM_MODEL.
# Локальная модель через Ollama:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Сколько запросов к модели идёт одновременно (на бесплатном тарифе 1–2)
MAX_PARALLEL=2
# LLM_TIMEOUT=600   # сколько секунд ждать ответа модели
# Сколько требований проверяется в одном запросе
REVIEW_BATCH=8

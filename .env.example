# Скопируйте этот файл в .env и вставьте свой ключ:  cp .env.example .env
# Файл .env в репозиторий не попадает (он в .gitignore).

# Google Gemini — бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Список моделей, доступных по ключу: python validate.py --list-models
GEMINI_MODEL=gemini-3.1-flash-lite

# Либо другой провайдер (используется первый найденный ключ):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Любой OpenAI-совместимый API (OpenRouter, Groq и т.п.):
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# Локальная модель через Ollama:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Сколько запросов к модели идёт одновременно (на бесплатном тарифе 1–2)
MAX_PARALLEL=2
# LLM_STREAM=1      # получать ответ потоком (нужно для NVIDIA API)
# LLM_TIMEOUT=600   # сколько секунд ждать ответа модели
# Сколько требований проверяется в одном запросе
REVIEW_BATCH=8
